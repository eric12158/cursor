mtllib flip_sequence.mtl

# Units: meters (approx). Axes: X length, Y width, Z up.

o platform
usemtl platform
v -0.60 -0.40 0.00
v  0.60 -0.40 0.00
v  0.60  0.40 0.00
v -0.60  0.40 0.00
v -0.60 -0.40 0.10
v  0.60 -0.40 0.10
v  0.60  0.40 0.10
v -0.60  0.40 0.10
f 1 2 3 4
f 5 8 7 6
f 1 5 6 2
f 2 6 7 3
f 3 7 8 4
f 4 8 5 1

o stop_block
usemtl stop
v 0.52 -0.12 0.10
v 0.58 -0.12 0.10
v 0.58  0.12 0.10
v 0.52  0.12 0.10
v 0.52 -0.12 0.50
v 0.58 -0.12 0.50
v 0.58  0.12 0.50
v 0.52  0.12 0.50
f 9 10 11 12
f 13 16 15 14
f 9 13 14 10
f 10 14 15 11
f 11 15 16 12
f 12 16 13 9

# Steel plate (step 1): lying flat on platform
o plate_step1
usemtl plate_step1
v -0.30 -0.25 0.10
v  0.30 -0.25 0.10
v  0.30  0.25 0.10
v -0.30  0.25 0.10
v -0.30 -0.25 0.11
v  0.30 -0.25 0.11
v  0.30  0.25 0.11
v -0.30  0.25 0.11
f 17 18 19 20
f 21 24 23 22
f 17 21 22 18
f 18 22 23 19
f 19 23 24 20
f 20 24 21 17

# Steel plate (step 2): leaned against stop (regrasp position)
# Represented as a thin quad (no thickness) for clarity.
o plate_step2
usemtl plate_step2
v 0.25 -0.25 0.11
v 0.25  0.25 0.11
v 0.55  0.25 0.45
v 0.55 -0.25 0.45
f 25 26 27 28

# Steel plate (step 3): flipped and placed back (slightly above to avoid z-fighting)
o plate_step3
usemtl plate_step3
v -0.30 -0.25 0.12
v  0.30 -0.25 0.12
v  0.30  0.25 0.12
v -0.30  0.25 0.12
v -0.30 -0.25 0.13
v  0.30 -0.25 0.13
v  0.30  0.25 0.13
v -0.30  0.25 0.13
f 29 30 31 32
f 33 36 35 34
f 29 33 34 30
f 30 34 35 31
f 31 35 36 32
f 32 36 33 29
